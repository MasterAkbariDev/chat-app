# Server
PORT=3001

# Comma-separated list of allowed CORS origins (e.g. http://localhost:3000,http://localhost:3002)
# Required — there is no wildcard fallback; the app fails to boot if this is unset/empty.
CORS_ORIGIN=http://localhost:3000

# Database (use 127.0.0.1 on Windows — localhost may resolve to IPv6 [::1] while MongoDB listens on IPv4)
# Docker: mongodb://mongodb:27017/chat?replicaSet=rs0
DATABASE_URL=mongodb://127.0.0.1:27018/chat?replicaSet=rs0

# Read-only source DB for the one-off legacy data migration (scripts/migrate-legacy-data.ts).
# Set this only when migrating from an existing legacy database; it is read-only.
DATABASE_URL_LEGACY=mongodb://127.0.0.1:27017/legacy-chat

# Redis (rate-limiter storage)
REDIS_URL=redis://127.0.0.1:6380

# Auth (required)
JWT_SECRET=your-secret-key-change-in-production

# Free "beta" key from developers.giphy.com — powers the global GIF/sticker tab
# (src/giphy/). Tenor is dead (Google froze signups 2026-01-14, shut it down 2026-06-30).
GIPHY_API_KEY=

# Self-hosted LiveKit (SFU) + coturn (TURN), same server as the app — see docker-compose.yml's
# livekit/coturn services and livekit.yaml.example. LIVEKIT_API_KEY/SECRET are a locally
# generated pair (e.g. `devkey$(openssl rand -hex 6)` / `openssl rand -hex 32`), NOT obtained
# from any external LiveKit Cloud account — they must match the `keys:` entry in livekit.yaml
# (copy livekit.yaml.example to livekit.yaml and fill both in with the same values).
LIVEKIT_URL=ws://127.0.0.1:7880
# Optional server-to-server URL for participant checks when the public URL uses a proxy path.
# LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Shared secret for coturn's --static-auth-secret (time-limited TURN credentials). Generate with
# `openssl rand -hex 24`. Only needed if/when the calls feature issues TURN credentials to
# clients; currently coturn runs alongside LiveKit but the app does not yet mint TURN creds.
TURN_SECRET=

# Optional: path to ffmpeg binary (auto-bundled on Windows/macOS dev)
# FFMPEG_PATH=

# Optional: override where DiskMediaStorageService writes files (default uploads/media under
# the project root). Tests set this to an isolated temp directory.
# MEDIA_STORAGE_ROOT=

# B11: switches every MediaService-backed upload (images/videos/clips/stickers/wallpaper) from
# local disk to the self-hosted MinIO container in docker-compose.yml — "disk" (default) or "s3".
MEDIA_STORAGE_DRIVER=disk

# Only read when MEDIA_STORAGE_DRIVER=s3. Self-hosted MinIO, not a cloud S3 account — same
# server as the app. Local (outside Docker): http://127.0.0.1:9010. Docker: http://minio:9000.
S3_ENDPOINT=http://127.0.0.1:9010
S3_BUCKET=media
S3_ACCESS_KEY_ID=media_admin
S3_SECRET_ACCESS_KEY=change-me-in-production

# Optional: days a MediaAsset can go unread before the nightly tiering job tags it "cold"
# (default 90). Metadata-only on self-hosted MinIO — see README's B11 section.
# MEDIA_COLD_TIER_DAYS=90

# Web refresh-token cookie (HttpOnly). Defaults are right for a same-site deployment.
# AUTH_COOKIE_SAMESITE=lax        # use "none" (forces Secure) only if the web app and API are on different sites
# AUTH_COOKIE_SECURE=true         # default: true when NODE_ENV=production; set false for http://localhost prod builds
# AUTH_COOKIE_PATH=/              # narrow it if the API is mounted under a path
# AUTH_COOKIE_DOMAIN=             # only to share the cookie across subdomains
